{
    "log": {
        "loglevel": "info",
        "access": "/logs/access.log 会在app.py里修改",
        "error": "/logs/error.log"
    },
    "inbounds": [
        {
            "listen": "::",
            "port": 9999,
            "protocol": "mixed",
            "settings": {
                "auth": "noauth",
                "udp": true,
                "ip": "::"
            }
        },
        {
            "tag": "input-x10",
            "listen": "::",
            "port": 10000,
            "protocol": "mixed",
            "settings": {
                "auth": "noauth",
                "udp": true,
                "ip": "::"
            }
        }
    ],
    "outbounds": [
        {
            "protocol": "vmess",
            "settings": {
                "vnext": [
                    {
                        "address": "{VMESS_ADDR}",
                        "port": "{VMESS_PORT}",
                        "users": [
                            {
                                "id": "{VMESS_UUID}",
                                "alterId": "{VMESS_AID}"
                            }
                        ]
                    }
                ]
            }
        },
        {
            "protocol": "shadowsocks",
            "settings":{
                "servers": [
                    {
                        "address": "{SS_ADDR}",
                        "port": "{SS_PORT}",
                        "method": "aes-256-gcm",
                        "password": "{PW}",
                        "ota": false,
                        "level": 0
                    }
                ]
            }
        }
    ],
    "routing": {
        "strategy": "rules",
        "settings": {
          "domainStrategy": "IPIfNonMatch"
        },
        "rules": [
          {   
            "type": "Field",
            "inboundTag": [
              "input-x10"
            ],
            "outboundTag": "output-x10"
          }
        ]
    }
}
